# VoiceChannel instance configuration: example.
#
# deploy.sh copies this file to $VOICE_DIR/env (default /root/.voice/env, mode 600) when that file
# does not exist yet, and later appends any active KEY=VALUE line below whose key is missing.
# It never changes a value that is already there. Edit the copy, not this example.
#
# Format: KEY=VALUE, one per line, no spaces around "=". Lines starting with # are comments.
# An empty value counts as unset (the default applies).
# Precedence: process environment, then this file, then the built-in default.
# After editing: systemctl restart voice-web. The tunnel does not read this file: deploy.sh copies VOICE_PORT,
# VOICE_ALLOWED_USER, VOICE_CHAT_ID, VOICE_MENU_TEXT and VOICE_BOT_TOKEN into $VOICE_DIR/tunnel.env (the only
# settings the tunnel can read, so it never sees an API key); run deploy.sh after changing one of them, it
# restarts the tunnel for it (a new public address).
#
# Process-environment only (not read from this file): VOICE_DIR (config directory, default /root/.voice;
# used by deploy.sh and the scripts) and VOICE_ENV_FILE (path of this file; used by voice-web, the
# channel server and the tunnel script, default /root/.voice/env).

# ---- Who may use it (required) ----------------------------------------------------------------
# Numeric Telegram user id of the one person allowed to use the Mini App. Message @userinfobot in
# Telegram to find yours. While this is empty, voice-web rejects every /api request.
VOICE_ALLOWED_USER=
# Chat that receives the text mirror of the conversation. Default: VOICE_ALLOWED_USER.
# VOICE_CHAT_ID=
# Set to 0 to stop mirroring the conversation into the Telegram chat.
VOICE_MIRROR_TG=1

# ---- Language and persona ---------------------------------------------------------------------
# Spoken language as a BCP-47 code, for example en-US, de-DE, ru-RU. It is sent to the speech
# recognizer and the speech synthesizer.
VOICE_LANG=en-US
# Optional. How the instructions given to Claude refer to the user; empty means "the user".
# VOICE_USER_NAME=
# Optional: female or male. Tells Claude which voice the replies are spoken in, so it uses the matching
# grammatical gender when it talks about itself (relevant for languages that have one). Empty = nothing.
# VOICE_ASSISTANT_GENDER=
# Label of the menu button in the bot chat. Read by the tunnel script when it starts (run deploy.sh after changing it).
VOICE_MENU_TEXT=Voice

# ---- Providers and keys -----------------------------------------------------------------------
# Speech recognition (STT) and speech synthesis (TTS) go through OpenRouter.
# OpenRouter API key (https://openrouter.ai/keys). Without a key the server runs in FAKE mode.
OPENROUTER_API_KEY=
# OpenRouter models: an audio-input model for STT, an audio-output model for TTS.
VOICE_STT_MODEL=google/gemini-3.5-flash-lite
VOICE_TTS_MODEL=openai/gpt-audio-mini
# Voice name for the OpenRouter TTS model (OpenAI voices: alloy, ash, ballad, coral, echo, fable, nova,
# onyx, sage, shimmer, verse, marin, cedar).
VOICE_TTS_OR_VOICE=alloy

# ---- Server -----------------------------------------------------------------------------------
# Local port of voice-web (it listens on 127.0.0.1 only).
VOICE_PORT=18200
# Directory for the inbox log and the last synthesized replies. Default: /root/.voice/state. The systemd unit sets it
# itself, to its state directory /var/lib/voice (so this key only matters when voice-web is started by hand), and
# the unit also points VOICE_TOKEN_FILE, VOICE_GLOSSARY_FILE and VOICE_TG_ENV_FILE at its credential copies.
# VOICE_STATE_DIR=
# File with the secret that protects the internal API. deploy.sh creates it. Default: /root/.voice/internal_token.
# VOICE_TOKEN_FILE=
# Directory that is served (public, read only) under /vendor/: the browser libraries of Live mode. deploy.sh fills
# /opt/voice/web/vendor from web/vendor.lock. Default: the "vendor" directory next to web/server.py.
# VOICE_VENDOR_DIR=
# Recognition glossary, one term per line, blank lines and lines starting with # ignored. Default: /root/.voice/glossary.txt.
# VOICE_GLOSSARY_FILE=

# ---- Security, retention and Live mode limits -------------------------------------------------
# All optional; the values shown are the defaults, so they are commented out. Read when voice-web starts.
# There is also an off switch that needs no setting and no restart: while the file DISABLED exists in the
# state directory (/var/lib/voice/DISABLED under systemd) every /api request is answered with 503 "voice input
# is disabled". Create it to stop all voice input at once, delete it to resume.
# Seconds the access data that Telegram gives the page stays valid (minimum 60). A page, or a Live
# conversation, left open longer gets "forbidden" and has to be reopened from the menu button.
# VOICE_AUTH_MAX_AGE=21600
# Content-Security-Policy of the page: enforce (the browser blocks what the policy forbids), report (the
# policy is only reported: violations show up in the log as "CSP:" lines, use it to test a change of the page)
# or off.
# VOICE_CSP=enforce
# Seconds a spoken reply (audio file) is kept on the server (minimum 60). At most the 20 newest files are
# kept in any case.
# VOICE_AUDIO_TTL=3600
# Days of inbox.jsonl (the log of what was said) to keep (minimum 1).
# VOICE_INBOX_DAYS=7
# Speech recognition requests accepted per minute and per hour (more get 429 "rate limited"; minimum 1 each).
# VOICE_UTT_PER_MINUTE=12
# VOICE_UTT_PER_HOUR=200
# Live mode stops after this many seconds without a touch on the page; 0 = never.
# VOICE_LIVE_IDLE_SEC=900
# Live mode stops after the app has been hidden (switched away, screen off) this many seconds; 0 = never.
# VOICE_LIVE_HIDDEN_SEC=60
# Replay: when the Claude Code session restarts, what was said in the last this-many seconds and was never
# received by the session is handed to it once, marked as missed (at most 10 utterances). 0 = off.
# VOICE_REPLAY_SEC=180
# Confirmation by a tap: how many seconds a confirmation card (the voice_confirm tool) waits in the app for a tap
# (10 to 95; the tool waits at most 100 s).
# VOICE_CONFIRM_TTL=90
# A tap on Confirm is accepted only from a page that was opened from the menu at most this many seconds ago
# (minimum 60; shorter than VOICE_AUTH_MAX_AGE on purpose). An older page is told to reopen the app.
# VOICE_CONFIRM_MAX_AGE=3600
# OpenRouter only. 1: speech recognition is routed only to endpoints with a zero-data-retention policy;
# 0: to any endpoint that does not store or train on the data (speech synthesis always uses that).
# Set 0 if VOICE_STT_MODEL has no zero-data-retention endpoint: recognition then fails with 502 and a log
# line "STT: OpenRouter has no endpoint ...".
# VOICE_OR_ZDR_STT=1

# ---- Telegram voice notes (channel server) ------------------------------------------------------
# The only folder the voice_transcribe tool reads audio files from (the Claude Code Telegram plugin saves
# downloaded attachments there). Default: ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/channels/telegram/inbox. Read when the
# Claude Code session starts.
# VOICE_TG_INBOX=

# ---- Telegram bot ------------------------------------------------------------------------------
# The bot whose menu button opens the Mini App. By default its token is read from the .env file of the
# Claude Code Telegram plugin (the TELEGRAM_BOT_TOKEN line). Change the path, or set VOICE_BOT_TOKEN to
# override the token directly. deploy.sh hands this file to the services as a credential (it reads this key; after
# changing it, run deploy.sh again). If the file does not exist the services get an empty one.
# VOICE_TG_ENV_FILE=/root/.claude/channels/telegram/.env
# VOICE_BOT_TOKEN=

# ---- restart_main_session.sh (Claude Code session helper) ----------------------------------------
# Each value can also come from the environment. The helper only reads these keys from this file.
# Id of the Claude Code session to resume (required for the helper).
CLAUDE_SESSION_ID=
# Name of the tmux session that runs Claude Code.
TMUX_SESSION=claude
# Working directory of the session. Default: $HOME. Determines where the session transcript is looked up.
# CLAUDE_WORKDIR=
# Claude Code executable. Default: $HOME/.local/bin/claude.
# CLAUDE_BIN=
# Value of the --channels option.
CLAUDE_CHANNELS=plugin:telegram@claude-plugins-official
# .env file of the Telegram plugin; the helper uses it to check which bot the plugin ended up with.
# Default: $HOME/.claude/channels/telegram/.env.
# TELEGRAM_ENV_FILE=

# ---- auth watchdog (session/auth_watch.sh, run every 5 minutes by voice-auth-watch.timer) ----------
# OFF by default: deploy.sh installs the units but enables the timer only when this is 1 (and switches it off again
# when the line is removed or changed). It tells you once in Telegram when the main session needs /login, hit the
# usage limit, has a billing/credit problem or does not exist, and warns when the session's context is nearly full.
# It reads the transcript of the session CLAUDE_SESSION_ID (below); without that id, or without its file, it only
# checks that the tmux session exists. It also uses TMUX_SESSION, CLAUDE_WORKDIR, VOICE_CHAT_ID (or
# VOICE_ALLOWED_USER) and the bot token from above. No Claude or API calls are made.
# VOICE_AUTH_WATCH=1
# Size of the session's context window in tokens (the fill is read from the session transcript). No default: it
# depends on the model, so without it there is no context warning (logged once). A fill above 105% of it is taken
# for a wrong setting: a warning, no message.
# VOICE_CONTEXT_WINDOW=
# Fraction of the window that triggers one warning (0 to 1); it is armed again only after the fill falls below 0.5.
# VOICE_CONTEXT_WARN=0.8
# Where the watchdog keeps its state. Default: its systemd state directory, /var/lib/voice-auth-watch.
# VOICE_AUTH_STATE_DIR=
